# Exceções: schema, migrations e testes RLS do Supabase SÃO versionados
# (não contêm credenciais; são a fonte da estrutura do banco).
!supabase/schema.sql
!supabase/migrations/*.sql
!supabase/tests/*.sql

# Testes: scripts automatizados são versionados. Ficam fora os roteiros
# manuais, SQL avulso e specs antigos que apontam para produção ou dependem
# de ferramentas não instaladas (vitest).
tests/*.md
tests/playwright-producao.spec.js
tests/calculos-financeiros.test.js
test-results/
playwright-report/
e2e/.auth/

